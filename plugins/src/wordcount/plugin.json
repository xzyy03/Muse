{
  "id": "wordcount",
  "name": "字数统计",
  "version": "1.0.0",
  "description": "统计一段文本的字符数、行数与词数",
  "author": "Muse",
  "tools": [
    {
      "name": "word_count",
      "description": "统计一段文本的字符数、行数与词数",
      "command": "sh {dir}/wordcount.sh",
      "timeout": 30,
      "parameters": [
        {
          "name": "text",
          "type": "string",
          "description": "要统计的文本",
          "required": true
        }
      ]
    }
  ]
}
